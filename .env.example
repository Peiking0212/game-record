# Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Edge Functions / scripts — never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=
# Test user (preferred — never commit real values; do not paste in chat)
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
# Or from DevTools → sb-*-auth-token JSON:
# TEST_USER_ACCESS_TOKEN=
# TEST_USER_REFRESH_TOKEN=
