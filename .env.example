NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ENV=development
APP_URL=http://localhost:8080

# --- Price ingest (Edge Function secrets: Dashboard → Edge Functions → Secrets) ---
# Primary: IsThereAnyDeal — https://isthereanydeal.com/dev/ (create app → API key)
# Required in production. Without it, ingest falls back to Steam + CheapShark (single-store).
ITAD_API_KEY=
ITAD_COUNTRY=CN
# Min delay between ITAD requests (ms); default 400
# Delay between ITAD HTTP calls (ms). Default 400. Cron every 6h is safe; avoid tight loops.
ITAD_REQUEST_DELAY_MS=400

# Fallback only (no key): Steam appdetails region
STEAM_STORE_CC=cn
STEAM_STORE_LANG=schinese

# CheapShark: no key — https://www.cheapshark.com/api (fallback when ITAD + Steam have no price)
